# Local development: use the Next.js rewrite proxy to Django.
NEXT_PUBLIC_DJANGO_API_URL=/api/backend
DJANGO_API_ORIGIN=http://127.0.0.1:8000

# Vercel production: add this variable in Vercel Project Settings.
# The value must include /api because Django exposes /api/auth and /api/records.
NEXT_PUBLIC_DJANGO_API_URL=https://fxj-suits.onrender.com/api

# Optional browser push key. Provider secrets belong in Render only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
