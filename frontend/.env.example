# Local development: use the Next.js rewrite proxy to Django.
NEXT_PUBLIC_DJANGO_API_URL=/api/backend
DJANGO_API_ORIGIN=http://127.0.0.1:8000

# Vercel production: replace with your public Render API URL.
# NEXT_PUBLIC_DJANGO_API_URL=https://your-backend.onrender.com/api

# Optional browser push key. Provider secrets belong in backend/.env or Render only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
