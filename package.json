{
  "name": "fxj-suits",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "install:all": "npm install --prefix frontend && python3 -m pip install -r backend/requirements.txt",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python3 backend/manage.py runserver 127.0.0.1:8000",
    "build": "npm run build --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "backend:check": "python3 backend/manage.py check",
    "backend:migrate": "python3 backend/manage.py migrate",
    "backend:seed": "python3 backend/manage.py seed_demo"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
