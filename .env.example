# =============================================
# FXJ SUITS — Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# Supabase Configuration (required)
# Get these from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional: WhatsApp/Twilio for notifications
# VITE_TWILIO_ACCOUNT_SID=your-twilio-sid
# VITE_TWILIO_AUTH_TOKEN=your-twilio-token
# VITE_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
